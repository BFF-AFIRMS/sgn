<!-- This captures console logs so they can be extracted by the selenium tests. -->
% if (!$c->config->{production_server}) {
<script type="text/javascript">
   window.jsErrorsAndLogs = window.jsErrorsAndLogs || [];
   (function() {
       const logToArr = (prefix, args) => {
           try {
               window.jsErrorsAndLogs.push(prefix + ": " + args.map(a => {
                   if (a === null) return "null";
                   if (a === undefined) return "undefined";
                   if (typeof a === 'object') {
                       try { return JSON.stringify(a); } catch(e) { return String(a); }
                   }
                   return String(a);
               }).join(" "));
           } catch(e) {
               window.jsErrorsAndLogs.push(prefix + ": (unserializable arguments)");
           }
       };
       const origLog = console.log;
       console.log = function(...args) {
           logToArr("LOG", args);
           if (origLog) origLog.apply(console, args);
       };
       const origWarn = console.warn;
       console.warn = function(...args) {
           logToArr("WARN", args);
           if (origWarn) origWarn.apply(console, args);
       };
       const origErr = console.error;
       console.error = function(...args) {
           logToArr("ERROR", args);
           if (origErr) origErr.apply(console, args);
       };
       const origOnError = window.onerror;
       window.onerror = function(msg, url, line, col, err) {
           window.jsErrorsAndLogs.push("UNCAUGHT ERROR: " + msg + " at " + url + ":" + line + (col ? ":" + col : ""));
           if (origOnError) return origOnError.apply(window, arguments);
           return false;
       };
   })();
</script>
% }

<meta http-equiv="content-type" content="text/html; charset=utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1"/>

  <!-- <link rel="stylesheet" href="/css/sgn.css" type="text/css" /> -->
  <link rel="search" type="application/opensearchdescription+xml" title="Search Database" href="/documents/sgn_sol_search.xml" />
  <& /util/import_css.mas, paths => [
    '/css/new_sgn.css',
    '/css/jquery-sgn-theme/jquery-ui-1.10.3.custom.css',
    '/css/jstree/themes/default/style.min.css',
    '/css/fullcalendar.min.css',
    '/documents/inc/datatables/jquery.dataTables.css',
    '/css/bootstrap.min.css',
    '/css/bootstrap-toggle/bootstrap-toggle.min.css',
    '/css/ladda-themeless.min.css',
    '/css/daterangepicker.css',
    '/css/buttons/buttons.bootstrap.min.css',
    '/css/bootstrap3-xl-class.css',
    '/css/bootstrap-select.min.css',
    '/css/colReorder.dataTables.min.css',
  ] &>

  <!-- <link rel="stylesheet" href="/documents/inc/colorbox/colorbox.css" type="text/css" /> -->
  <!-- <link rel="stylesheet" type="text/css" href="/css/dataTables.bootstrap.min.css"> -->

<script language="javascript" type="text/javascript">
   JSAN = {};
   JSAN.use = function() {};
   MochiKit = {__export__: false};
</script>

<& /util/import_javascript.mas, classes => [
    "jquery",
    "jqueryui",
    "sgn",
    "jquery.simpletooltip",
    "jquery.cookie",
    "CXGN.Effects",
    "CXGN.Dataset",
    "CXGN.Page.FormattingHelpers",
    "CXGN.UserPrefs",
    "CXGN.Page.Toolbar",
    "CXGN.List",
    "CXGN.Login",
    "bootstrap_min",
    "CXGN.BreedersToolbox.HTMLSelect",
    "bootstrap-toggle_min"
] &>

<%perl>
    my @all_environments = qw(
        jszip-min pdfmake.pdfmake-min pdfmake.vfs_fonts
        jquery.dataTables-buttons-min
        jquery.dataTables-buttons-bootstrap-min
        jquery.dataTables-buttons-html5-min
        jquery.dataTables-buttons-print-min
        jquery.dataTables-colReorder-min
        jquery.dataTables-select-min
    );
    my @current_environment = $c->config->{production_server} ? qw(jquerymigrate-min jquery.dataTables-min) : qw(jquerymigrate jquery.dataTables);
</%perl>
<& /util/import_javascript.mas, classes => [ @current_environment, @all_environments ] &>

<script type="text/javascript"
  src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-AMS-MML_HTMLorMML">
</script>

<& /site/header/local_head.mas &>
