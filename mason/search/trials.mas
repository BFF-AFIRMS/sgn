
<%args>
$location_id => 'not_provided'
</%args>

<& /page/page_title.mas, title => "Trial Search" &>

<div class="well well-sm">
    <div class="panel panel-default">
        <div class="panel-body">
            <table id="trial_search_results" width="100%" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Trial name</th>
                        <th>Description</th>
                        <th>Breeding program</th>
                        <th>Folder</th>
                        <th>Year</th>
                        <th>Location</th>
                        <th>Trial type</th>
                        <th>Design</th>
                        <th>Planting Date</th>
                        <th>Harvest Date</th>
                        <th>Download</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
                <tfoot>
                    <tr>
                        <!-- These cells are replaced by search boxes at runtime -->
                        <th>Trial name</th>
                        <th>Description</th>
                        <th>Breeding program</th>
                        <th>Folder</th>
                        <th>Year</th>
                        <th>Location</th>
                        <th>Trial type</th>
                        <th>Design</th>
                        <th>Planting Date</th>
                        <th>Harvest Date</th>
                        <th>Download</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-body">
            <br><br>
            <&| /page/info_section.mas, title => 'Copy Results to a List', collapsible=>1, collapsed=>0, subtitle=>'<i>Copy the trial names currently showing in the search results table to a new or exisiting list</i>'&>
                <br>
                <div style="text-align:right" id="trials_to_list_menu"></div>
                <div id="trial_result_names" style="display: none;"></div>
            </&>
        </div>
    </div>
</div>


<script>

jQuery(document).ready(function () {
    $('#trial_search_results tfoot th').each(function (i) {
        const title = $('#trial_search_results thead th').eq($(this).index()).text();
        $(this).html( '<input type="text" placeholder="'+title+'" data-index="'+i+'" />')
    });

    const trial_table = jQuery('#trial_search_results').DataTable( {
        'ajax': '/ajax/search/trials?location_id=<% $location_id %>',
        "scrollX": true
    });

    $(trial_table.table().container()).on('keyup', 'tfoot input', function () {
        trial_table
            .column($(this).data('index'))
            .search(this.value)
            .draw();
    });

    jQuery('#trial_search_results').on( 'draw.dt', function () {
        const name_links = trial_table.column( 0, {page:'current'} ).data();
        const names = [];

        for (let i = 0; i < name_links.length; i++) { //extract text from anchor tags
            names.push(name_links[i].match(/<a [^>]+>([^<]+)<\/a>/)[1]+'\n');
        }

        jQuery('#trial_result_names').html(names);
        addToListMenu('trials_to_list_menu', 'trial_result_names', {
            listType: 'trials'
        });
    });

});

</script>
