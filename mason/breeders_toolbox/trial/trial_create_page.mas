<%args>
$locations
$breeding_programs
$management_factor_types => ()
$design_types => ()
</%args>

<%once>
use JSON;
</%once>

<%init>
my $json = JSON->new->allow_nonref;
my $locations_json = $json->encode($locations || []);
my $breeding_programs_json = $json->encode($breeding_programs || []);
my $design_types_json = $json->encode(ref $design_types eq 'ARRAY' ? $design_types : []);
my $management_factor_types_json = $json->encode(ref $management_factor_types eq 'ARRAY' ? $management_factor_types : []);
</%init>

<& /util/import_javascript.mas, entries => ['add_trial'], classes => [ 'CXGN.TrialTreeFolders', 'CXGN.List' ] &>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <& /page/page_title.mas, title=>"Design New Trial" &>
            <div id="add_trial_root"></div>
        </div>
    </div>
</div>

<script type="text/javascript">
jQuery(document).ready(function() {
    window.jsMod['add_trial'].init('add_trial_root', {
        locations: <% $locations_json %>,
        breeding_programs: <% $breeding_programs_json %>,
        design_types: <% $design_types_json %>,
        management_factor_types: <% $management_factor_types_json %>
    });
});
</script>
