<%doc>
Generic Accordion Component
Encapsulates accordion workflow behavior.
Accepts a list of steps with content and validation functions.
Usage:
  <&| /util/workflow_accordion.mas, id => "my_accordion" &>
      <&| /util/workflow_accordion.mas:step, id => "step1", title => "Step 1", validate => "validate_step1" &>
          Content for Step 1
      </&>
      ...
  </&>
Or:
  <& /util/workflow_accordion.mas, id => "my_accordion", steps => [
      { id => "step1", title => "Step 1", content => "...", validate => "validate_step1" },
      ...
  ] &>
</%doc>
<%args>
  $id
  $steps => undef
</%args>

<%shared>
  my @step_ids = ();
  my @titles = ();
  my @contents = ();
  my @validations = ();
</%shared>

<%init>
  @step_ids = ();
  @titles = ();
  @contents = ();
  @validations = ();

  if ($steps && ref $steps eq 'ARRAY') {
      foreach my $s (@$steps) {
          push @step_ids, $s->{id} || '';
          push @titles, $s->{title} || '';
          push @contents, $s->{content} || '';
          push @validations, $s->{validate} || '';
      }
  }
</%init>

<%method step>
  <%args>
    $id => ""
    $title => ""
    $validate => ""
  </%args>
  <%init>
    push @step_ids, $id;
    push @titles, $title;
    push @contents, $m->content;
    push @validations, $validate;
  </%init>
</%method>

<%perl>
  $m->content; # Execute body to collect method calls
  my $json = JSON::XS->new();
  my $validations_json = $json->encode(\@validations);
  my $id_json = $json->encode($id);
</%perl>

<style media="screen">
  .accordion-workflow .accordion-step-panel {
      margin-bottom: 15px;
  }
  .accordion-workflow .accordion-locked {
      opacity: 0.5 !important;
      cursor: not-allowed !important;
  }
  .accordion-workflow .accordion-locked * {
      cursor: not-allowed !important;
  }
</style>

<div id="<% $id %>" class="panel-group accordion-workflow">
% for (my $i = 0; $i < scalar(@titles); $i++) {
%   my $step_id = $step_ids[$i] || ($id . "_step_" . $i);
    <div class="accordion-step-panel" id="<% $id %>_panel_<% $i %>" data-step-index="<% $i %>">
        <& /page/info_section.mas,
            title => $titles[$i],
            collapsible => 1,
            collapsed => ($i == 0 ? 0 : 1),
            id => $id . "_collapse_" . $i,
            is_subsection => 1,
            contents => $contents[$i]
        &>
    </div>
% }
</div>

<script type="text/javascript">
jQuery(document).ready(($) => {
    const containerId = <% $id_json %>;
    const validations = <% $validations_json %>;
    const $container = $('#' + containerId);
    if (!$container.length) return;

    const panels = $container.find('.accordion-step-panel');
    const numPanels = panels.length;
    let unlockedUpTo = 0;
    let updateTimeout = null;

    /**
    * Resolves a validation function from a global function name.
    * If no matching function is found on window, returns a default function that passes validation.
    * 
    * @param {string} v - The global validation function name.
    * @returns {function} The resolved validation function.
    */
    const getValidationFn = (v) => {
        if (typeof v === 'string' && v.trim() !== '') {
            if (typeof window[v] === 'function') {
                return window[v];
            }
        }
        return () => true;
    }

    const validationFns = validations.map(getValidationFn);

    /**
    * Normalizes any validation return value (boolean, string, or object)
    * into a consistent validation status object.
    * 
    * @param {*} res - The raw value returned by a validation function.
    * @returns {{valid: boolean, message?: string}} Normalized validation status object.
    */
    const normalizeResult = (res) => {
        if (res === true || res === null || res === undefined || res === '') {
            return { valid: true };
        }
        if (typeof res === 'string') {
            return { valid: false, message: res };
        }
        if (typeof res === 'object' && res.valid === false) {
            return { valid: false, message: res.message || 'Validation failed' };
        }
        if (res === false) {
            return { valid: false, message: 'Validation failed' };
        }
        return { valid: true };
    }

    /**
    * Asynchronously validates a single step index.
    * Handles both synchronous return values and Promise-based async returns.
    * 
    * @param {number} i - The 0-based index of the step to validate.
    * @returns {Promise<{valid: boolean, message?: string}>} A promise resolving to the normalized validation status.
    */
    const validateStep = async (i) => {
        const fn = validationFns[i];
        if (!fn) return { valid: true };
        
        try {
            return normalizeResult(await fn());
        } catch(e) {
            return { valid: false, message: e.message || 'Error validating step' };
        }
    }

    /**
    * Evaluates all accordion steps sequentially.
    * Chains validation checks to find the first step that fails.
    * 
    * @returns {Promise<{index: number, message: string|null}>} A promise resolving to the first failing step index and error message.
    */
    const getFirstFailingStep = async () => {
        for (let i = 0; i < numPanels; i++) {
            const res = await validateStep(i);
            if (!res.valid) {
                return { index: i, message: res.message };
            }
        }
        return { index: numPanels, message: null };
    }

    /**
    * Debounces and triggers UI state updates for all accordion panels.
    * Locks/unlocks headers, collapses locked steps, and auto-opens the newly unlocked step.
    * 
    * @returns {void}
    */
    const updateAccordionState = () => {
        if (updateTimeout) {
            clearTimeout(updateTimeout);
        }
        updateTimeout = setTimeout(async () => {
            updateTimeout = null;
            const failing = await getFirstFailingStep();
            const maxUnlocked = failing.index;

            panels.each((idx, el) => {
                var $trigger = $(el).find('.info-section-trigger');
                if (idx > maxUnlocked) {
                    $trigger.addClass('accordion-locked');
                } else {
                    $trigger.removeClass('accordion-locked');
                }
            });

            for (let i = maxUnlocked + 1; i < numPanels; i++) {
                const $collapse = $('#' + containerId + '_collapse_' + i);
                if ($collapse.hasClass('in')) {
                    $collapse.collapse('hide');
                }
            }

            for (let j = unlockedUpTo + 1; j <= maxUnlocked; j++) {
                if (j < numPanels) {
                    const $collapseToOpen = $('#' + containerId + '_collapse_' + j);
                    if (!$collapseToOpen.hasClass('in')) {
                        $collapseToOpen.collapse('show');
                    }
                }
            }

            unlockedUpTo = maxUnlocked;
        }, 150);
    }

    // Ensure the first step is open on initial load
    const $firstCollapse = $('#' + containerId + '_collapse_0');
    if (!$firstCollapse.hasClass('in')) {
        $firstCollapse.collapse('show');
    }

    // Attach click handlers to each panel's trigger to manage accordion behavior
    panels.each((idx) => {
        const $panel = $(panels[idx]);
        const $trigger = $panel.find('.info-section-trigger');
        const $collapse = $('#' + containerId + '_collapse_' + idx);

        $trigger.on('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();

            const failing = await getFirstFailingStep();

            if (idx > failing.index) {
                alert(failing.message);
                return;
            }

            if ($collapse.hasClass('in')) {
                $collapse.collapse('hide');
            } else {
                $collapse.collapse('show');
            }
        });
    });

    // Listen for input changes to trigger validation and state updates
    $container.on('change keyup input', 'input, select, textarea', () => {
        updateAccordionState();
    });

    // Initial state update
    setTimeout(() => {
        updateAccordionState();
    }, 150);

    // Instance-scoped API: attach helper methods to this accordion's container data.
    // Use when caller already has the container reference (no global lookup needed).
    $container.data('accordionWorkflow', {
        updateState: () => updateAccordionState(),
        validateAll: () => getFirstFailingStep()
    });

    // Global update hook: expose update by a unique window key for callers that do not
    // have a container reference (e.g., legacy code or cross-component event handlers).
    window[containerId + '_update'] = updateAccordionState;
});
</script>
